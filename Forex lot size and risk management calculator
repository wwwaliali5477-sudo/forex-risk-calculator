<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lot Size Calculator</title>

<style>
body{
    background:#0f172a;
    color:white;
    font-family:Arial;
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.box{
    background:#1e293b;
    padding:30px;
    border-radius:20px;
    width:350px;
    box-shadow:0 0 20px rgba(0,0,0,0.4);
}

h1{
    text-align:center;
    margin-bottom:25px;
}

input,select{
    width:100%;
    padding:12px;
    margin-top:10px;
    margin-bottom:15px;
    border:none;
    border-radius:10px;
    background:#334155;
    color:white;
    font-size:16px;
}

button{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    background:#f59e0b;
    color:white;
    font-size:18px;
    cursor:pointer;
}

.result{
    margin-top:20px;
    background:#334155;
    padding:15px;
    border-radius:10px;
    text-align:center;
    font-size:22px;
}
</style>
</head>

<body>

<div class="box">

<h1>حاسبة اللوت</h1>

<select id="pair">
<option>EURUSD</option>
<option>GBPUSD</option>
<option>USDJPY</option>
<option>XAUUSD</option>
</select>

<input type="number" id="balance" placeholder="حجم الحساب">

<input type="number" id="risk" placeholder="نسبة المخاطرة %">

<input type="number" id="sl" placeholder="Stop Loss">

<button onclick="calculateLot()">احسب اللوت</button>

<div class="result" id="result">
النتيجة تظهر هنا
</div>

</div>

<script>

function calculateLot(){

let balance = parseFloat(document.getElementById("balance").value);
let risk = parseFloat(document.getElementById("risk").value);
let sl = parseFloat(document.getElementById("sl").value);
let pair = document.getElementById("pair").value;

let pipValue = 10;

if(pair == "USDJPY"){
    pipValue = 9;
}

if(pair == "XAUUSD"){
    pipValue = 1;
}

let riskMoney = balance * (risk / 100);

let lot = riskMoney / (sl * pipValue);

document.getElementById("result").innerHTML =
"حجم اللوت المناسب: " + lot.toFixed(2);

}

</script>

</body>
</html>
